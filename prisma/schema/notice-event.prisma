// -------------------- NOTICES, NEWS & CO-CURRICULAR EVENTS --------------------

model Notice {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(200)
  description String
  attachment  String?
  publishedAt DateTime?
  status      NoticeStatus @default(DRAFT)
  createdBy   String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator User @relation("NoticeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model News {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(200)
  description String
  image       String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model EventCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique @db.VarChar(100)
  type        EventCategoryType @unique
  description String?
  events      Event[]
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  image       String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([startDate, isPublished])
}

model Career {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(200) /// নিয়োগ বিজ্ঞপ্তির শিরোনাম
  description  String                     /// পদের বিবরণ ও আবেদনের শর্তাবলী
  circularFile String?                    /// সার্কুলার পিডিএফ / ফাইল ডাউনলোড লিংক
  deadline     DateTime  @db.Date         /// আবেদনের শেষ তারিখ
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, deadline])
}
