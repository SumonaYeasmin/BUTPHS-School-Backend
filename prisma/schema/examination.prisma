// -------------------- EXAMINATION & RESULTS --------------------

model GradingScale {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  description     String?
  maxGpa          Decimal  @default(5.00) @db.Decimal(3, 2)
  isDefault       Boolean  @default(false)
  isSystemDefault Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gradeRanges GradeRange[]
  exams       Exam[]
}

model GradeRange {
  id             String  @id @default(uuid()) @db.Uuid
  gradingScaleId String  @db.Uuid
  minPercentage  Decimal @db.Decimal(5, 2)
  maxPercentage  Decimal @db.Decimal(5, 2)
  letterGrade    String  @db.VarChar(5)
  gradePoint     Decimal @db.Decimal(3, 2)
  remarks        String? @db.VarChar(50)
  isFailGrade    Boolean @default(false)
  displayOrder   Int     @default(0)

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@unique([gradingScaleId, letterGrade])
  @@index([gradingScaleId, minPercentage, maxPercentage])
}

model Exam {
  id                  String                  @id @default(uuid()) @db.Uuid
  academicYearId      String                  @db.Uuid
  classId             String                  @db.Uuid
  gradingScaleId      String                  @db.Uuid
  name                String                  @db.VarChar(150)
  examType            ExamType
  startDate           DateTime                @db.Date
  endDate             DateTime                @db.Date
  status              ExamStatus              @default(UPCOMING)
  marksEntryDeadline  DateTime?
  allowCombinedPass   Boolean                 @default(true)
  weightagePercentage Decimal?                @db.Decimal(5, 2)
  resultStatus        ResultPublicationStatus @default(DRAFT)
  publishedAt         DateTime?
  isLocked            Boolean                 @default(false)
  isDeleted           Boolean                 @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass     SchoolClass            @relation(fields: [classId], references: [id], onDelete: Restrict)
  gradingScale    GradingScale           @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  examSubjects    ExamSubject[]
  examRoutines    ExamRoutine[]
  subjectResults  StudentSubjectResult[]
  resultSummaries ResultSummary[]
  consolidatedSources  ConsolidatedExamConfig[] @relation("ConsolidatedParent")
  usedInConsolidations ConsolidatedExamConfig[] @relation("ConsolidatedSource")

  @@unique([academicYearId, classId, name])
  @@index([academicYearId, classId])
}

model ExamSubject {
  id                            String   @id @default(uuid()) @db.Uuid
  examId                        String   @db.Uuid
  subjectId                     String   @db.Uuid
  groupId                       String?  @db.Uuid
  fullMarks                     Decimal  @db.Decimal(7, 2)
  passMarks                     Decimal  @db.Decimal(7, 2)
  hasWritten                    Boolean  @default(true)
  writtenFullMarks              Decimal? @db.Decimal(7, 2)
  writtenPassMarks              Decimal? @db.Decimal(7, 2)
  hasMcq                        Boolean  @default(false)
  mcqFullMarks                  Decimal? @db.Decimal(7, 2)
  mcqPassMarks                  Decimal? @db.Decimal(7, 2)
  hasPractical                  Boolean  @default(false)
  practicalFullMarks            Decimal? @db.Decimal(7, 2)
  practicalPassMarks            Decimal? @db.Decimal(7, 2)
  hasContinuousAssessment       Boolean  @default(false)
  continuousAssessmentFullMarks Decimal? @db.Decimal(7, 2)
  continuousAssessmentPassMarks Decimal? @db.Decimal(7, 2)
  isOptional                    Boolean  @default(false) /// ঐচ্ছিক / ৪র্থ বিষয় হিসেবে নেওয়া সম্ভব কিনা

  exam           Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  group          AcademicGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  marks          Mark[]
  subjectResults StudentSubjectResult[]
  examRoutines   ExamRoutine[]

  @@unique([examId, subjectId])
  @@index([examId, groupId])
}

model ExamRoutine {
  id            String  @id @default(uuid()) @db.Uuid
  examId        String  @db.Uuid
  examSubjectId String  @db.Uuid
  sectionId     String? @db.Uuid /// ঐচ্ছিক: নির্দিষ্ট সেকশনের জন্য আলাদা রুম হলে

  examDate     DateTime          @db.Date /// পরীক্ষার তারিখ
  startTime    DateTime          @db.Time(0) /// শুরু (যেমন: সকাল ১০:০০)
  endTime      DateTime          @db.Time(0) /// শেষ (যেমন: দুপুর ০১:০০)
  roomNo       String?           @db.VarChar(50) /// পরীক্ষার রুম / হল নম্বর (যেমন: রুম ১০২)
  status       ExamRoutineStatus @default(SCHEDULED) /// রুটিন স্ট্যাটাস (SCHEDULED, POSTPONED, CANCELLED, COMPLETED)
  instructions String? /// বিশেষ নির্দেশনা (যেমন: ক্যালকুলেটর নিষিদ্ধ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Restrict)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)
  section     Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([examId, examSubjectId, sectionId])
  @@index([examId, examDate])
  @@index([examDate, roomNo])
}

model Mark {
  id                  String @id @default(uuid()) @db.Uuid
  studentEnrollmentId String @db.Uuid
  examSubjectId       String @db.Uuid

  writtenMarks              Decimal @default(0) @db.Decimal(7, 2) /// লিখিত পরীক্ষার নম্বর
  mcqMarks                  Decimal @default(0) @db.Decimal(7, 2) /// MCQ পরীক্ষার নম্বর
  practicalMarks            Decimal @default(0) @db.Decimal(7, 2) /// ব্যবহারিক নম্বর (যদি থাকে)
  continuousAssessmentMarks Decimal @default(0) @db.Decimal(7, 2) /// ধারাবাহিক মূল্যায়ন (যদি থাকে)
  totalMarks                Decimal @db.Decimal(7, 2) /// মোট নম্বর

  isAbsent Boolean @default(false) /// পরীক্ষায় অনুপস্থিত ছিল কিনা
  isLocked Boolean @default(false) /// রেজাল্ট ফাইনাল হলে লক (এডিট বন্ধ)

  enteredBy String   @db.Uuid /// যে শিক্ষক নম্বর ইনপুট দিয়েছেন
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment  StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  examSubject ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)
  creator     User              @relation("MarksEnteredBy", fields: [enteredBy], references: [id], onDelete: Restrict)

  @@unique([studentEnrollmentId, examSubjectId])
  @@index([examSubjectId, studentEnrollmentId])
}

model StudentSubjectResult {
  id                  String   @id @default(uuid()) @db.Uuid
  studentEnrollmentId String   @db.Uuid
  examId              String   @db.Uuid
  examSubjectId       String   @db.Uuid
  totalMarks          Decimal  @db.Decimal(7, 2) /// মোট নম্বর
  letterGrade         String?  @db.VarChar(5) /// লেটার গ্রেড (A+, A, B ইত্যাদি)
  gradePoint          Decimal? @db.Decimal(3, 2) /// গ্রেড পয়েন্ট (৫.০০, ৪.০০ ইত্যাদি)
  isPassed            Boolean /// এই বিষয়ে পাস করেছে কিনা
  isOptional          Boolean  @default(false) /// এই শিক্ষার্থীর জন্য এটি ৪র্থ/ঐচ্ছিক বিষয় ছিল কিনা
  bonusGradePoint     Decimal? @default(0) @db.Decimal(3, 2) /// ৪র্থ বিষয়ের অতিরিক্ত পয়েন্ট যা মূল জিপিএ-তে যুক্ত হয়েছে (পয়েন্ট - ২.০০)
  isAbsent            Boolean  @default(false)
  calculatedAt        DateTime @default(now())

  enrollment  StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  exam        Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  examSubject ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)

  @@unique([studentEnrollmentId, examSubjectId])
  @@index([examId, studentEnrollmentId])
}

model ResultSummary {
  id                   String       @id @default(uuid()) @db.Uuid
  studentEnrollmentId  String       @db.Uuid
  examId               String       @db.Uuid
  totalFullMarks       Decimal      @db.Decimal(9, 2) /// সব বিষয়ের সর্বমোট পূর্ণমান (যেমন: ৯০০ বা ১০০০)
  totalMarks           Decimal      @db.Decimal(9, 2) /// সব বিষয় মিলিয়ে মোট প্রাপ্ত নম্বর (যেমন: ৭২০)
  gpa                  Decimal?     @db.Decimal(3, 2) /// অর্জিত মোট জিপিএ (GPA - ৪র্থ বিষয় সহ)
  gpaWithoutOptional   Decimal?     @db.Decimal(3, 2) /// ৪র্থ বিষয় ছাড়া জিপিএ (GPA without 4th subject)
  letterGrade          String?      @db.VarChar(5) /// সামগ্রিক গ্রেড (A+, A, F ইত্যাদি)
  meritPosition        Int? /// পুরো ক্লাসের মেধা স্থান (১ম, ২য়, ৩য় ইত্যাদি)
  sectionMeritPosition Int? /// নিজ সেকশনের মেধা স্থান
  failedSubjectCount   Int          @default(0) /// ফেল করা বিষয়ের সংখ্যা
  resultStatus         ResultStatus /// চূড়ান্ত অবস্থা (PASS, FAIL, INCOMPLETE)
  publishedAt          DateTime? /// ফলাফল প্রকাশের সময়
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  enrollment StudentEnrollment  @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  exam       Exam               @relation(fields: [examId], references: [id], onDelete: Restrict)
  promotions StudentPromotion[]

  @@unique([studentEnrollmentId, examId])
  @@index([examId, meritPosition])
}

model ConsolidatedExamConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  consolidatedExamId  String   @db.Uuid
  sourceExamId        String   @db.Uuid
  weightagePercentage Decimal  @db.Decimal(5, 2) /// সমন্বিত ফলাফলে এই পরীক্ষার শতকরা হার (যেমন: ৩০.০০ বা ৭০.০০)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  consolidatedExam Exam @relation("ConsolidatedParent", fields: [consolidatedExamId], references: [id], onDelete: Cascade)
  sourceExam       Exam @relation("ConsolidatedSource", fields: [sourceExamId], references: [id], onDelete: Restrict)

  @@unique([consolidatedExamId, sourceExamId])
  @@index([sourceExamId])
}
