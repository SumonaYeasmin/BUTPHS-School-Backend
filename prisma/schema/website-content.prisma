// -------------------- WEBSITE CONTENT & MEDIA --------------------

model WebsiteBanner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?  @db.VarChar(200)
  subtitle  String?
  image     String
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LeadershipMessage {
  id          String         @id @default(uuid()) @db.Uuid
  personName  String         @db.VarChar(150)
  designation String         @db.VarChar(100)
  photo       String?
  message     String
  type        LeadershipType
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, isPublished])
}

model Gallery {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(150)
  description String?
  category    String?        @db.VarChar(100)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  media       GalleryMedia[]
}

model GalleryMedia {
  id        String    @id @default(uuid()) @db.Uuid
  galleryId String    @db.Uuid
  mediaUrl  String
  mediaType MediaType
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
}

model AdmissionContent {
  id                String    @id @default(uuid()) @db.Uuid
  title             String    @db.VarChar(200)          /// যেমন: "২০২৬ শিক্ষাবর্ষে ৬ষ্ঠ হতে ৯ম শ্রেণিতে ভর্তি চলছে"
  subTitle          String?   @db.VarChar(250)          /// যেমন: "সীমিত আসনে মেধার ভিত্তিতে ভর্তি"
  academicSession   String?   @db.VarChar(50)           /// শিক্ষাবর্ষ (যেমন: "২০২৬")
  description       String?                             /// বিস্তারিত বিবরণ বা ভর্তি সার্কুলারের মূল বক্তব্য
  admissionInfo     String?                             /// ভর্তির নিয়মাবলী, পরীক্ষার তারিখ বা লটারির নিয়ম
  requiredDocuments String?                             /// প্রয়োজনীয় কাগজপত্র (জন্ম সনদ, ছবি, প্রত্যয়নপত্র ইত্যাদি)
  formPdfUrl        String?                             /// ভর্তির আবেদন ফরম ডাউনলোড লিংক (PDF)
  circularPdfUrl    String?                             /// ভর্তি বিজ্ঞপ্তির অফিসিয়াল নোটিশ বা সার্কুলার PDF লিংক
  image             String?                             /// ব্যানার বা আকর্ষণীয় ছবি
  applicationFee    Decimal?  @db.Decimal(7, 2)         /// আবেদন ফরম বা ভর্তি ফি (যদি থাকে, যেমন: ২০০.০০)
  startDate         DateTime? @db.Date                  /// আবেদন বা ফরম বিতরণের শুরুর তারিখ
  endDate           DateTime? @db.Date                  /// আবেদন বা ফরম জমা দেওয়ার শেষ তারিখ
  helplinePhone     String?   @db.VarChar(50)           /// ভর্তি সংক্রান্ত হেল্পলাইন / ফোন নম্বর
  isPublished       Boolean   @default(true)            /// ওয়েবসাইটে প্রদর্শিত হবে কি না
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isPublished])
}

model ContactInformation {
  id        String   @id @default(uuid()) @db.Uuid
  address   String
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Aggregate-only public attendance data; never expose individual student attendance publicly.
model AttendancePublicSummary {
  id           String   @id @default(uuid()) @db.Uuid
  summaryDate  DateTime @db.Date
  title        String   @db.VarChar(200)
  description  String?
  presentCount Int?
  absentCount  Int?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([summaryDate])
}

model Publication {
  id          String          @id @default(uuid()) @db.Uuid
  title       String          @db.VarChar(200)
  type        PublicationType
  description String?
  coverImage  String?
  fileUrl     String?
  publishYear Int?
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isPublished])
}

model Achievement {
  id          String          @id @default(uuid()) @db.Uuid
  title       String          @db.VarChar(200)
  type        AchievementType
  personName  String?         @db.VarChar(150)
  batch       String?         @db.VarChar(50)
  description String?
  image       String?
  achievedAt  DateTime?       @db.Date
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isPublished])
}
